{
  "name": "shellsmith",
  "productName": "ShellSmith",
  "desktopName": "shellsmith.desktop",
  "version": "1.1.2",
  "description": "Profesionální SSH/SFTP terminál s adresářovým stromem, taby a multi-session správou",
  "main": "src/main/main.js",
  "author": {
    "name": "Belphareon",
    "email": "geofery.cz@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "watch:renderer": "node scripts/build-renderer.mjs --watch",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm test && npm run build:renderer",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "dist": "npm run build:renderer && electron-builder --linux AppImage deb",
    "dist:deb": "npm run build:renderer && electron-builder --linux deb",
    "licenses": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "cz.belphareon.shellsmith",
    "productName": "ShellSmith",
    "copyright": "© 2026 Belphareon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/js/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;RemoteAccess;System;TerminalEmulator",
      "icon": "build/icons",
      "synopsis": "SSH a SFTP terminál s adresářovým stromem",
      "description": "Terminálový klient s adresářovým stromem, taby, rozdělenými panely a přenosem souborů přes SFTP.",
      "desktop": {
        "entry": {
          "Name": "ShellSmith",
          "GenericName": "SSH a SFTP terminál",
          "Keywords": "ssh;sftp;terminal;konzole;server;",
          "StartupWMClass": "shellsmith"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "npmRebuild": true
  },
  "homepage": "https://github.com/Belphareon-bak/ShellSmith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belphareon-bak/ShellSmith.git"
  },
  "bugs": {
    "url": "https://github.com/Belphareon-bak/ShellSmith/issues"
  },
  "keywords": [
    "ssh",
    "sftp",
    "terminal",
    "electron",
    "xterm",
    "mobaxterm",
    "kde",
    "linux"
  ]
}
